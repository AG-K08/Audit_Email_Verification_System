rule Credential_Dumping_Mimikatz
{
    meta:
        description = "Detects usage of Mimikatz tool for credential dumping"
        author = "And"
        date = "2024-09-17"
        threat_level = "high"
        tactic = "Credential Access"
        technique = "Credential Dumping"
        reference = "https://attack.mitre.org/techniques/T1003/"

    strings:
        // Строки, типичные для Mimikatz
        $mimikatz_str1 = "mimikatz" ascii
        $mimikatz_str2 = "sekurlsa::logonpasswords" ascii
        $mimikatz_str3 = "sekurlsa::wdigest" ascii
        $mimikatz_str4 = "lsadump::dcsync" ascii
        $mimikatz_str5 = "privilege::debug" ascii
        $mimikatz_str6 = "crypto::capi" ascii
        $mimikatz_str7 = "crypto::certificates" ascii
        $mimikatz_str8 = "sekurlsa::tickets" ascii
        $mimikatz_str9 = "sekurlsa::dpapi" ascii
        $mimikatz_str10 = "sekurlsa::msv" ascii

        // Известные бинарные сигнатуры Mimikatz
        $mimikatz_bin1 = { 50 6B 22 3F 78 5C 1B E0 00 04 01 3F 90 03 72 6F }
        $mimikatz_bin2 = { 4D 69 6D 69 6B 61 74 7A 2E 65 78 65 } // "Mimikatz.exe" в hex

    condition:
        // Обнаружение по строкам или бинарным сигнатурам
        any of ($mimikatz_str*) or any of ($mimikatz_bin*)
}
